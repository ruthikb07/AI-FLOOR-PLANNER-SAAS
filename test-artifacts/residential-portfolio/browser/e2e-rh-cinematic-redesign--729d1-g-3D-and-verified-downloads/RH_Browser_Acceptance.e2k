  LOADPATTERN "DEAD"  TYPE "Dead"  SELFWEIGHT 1
  LOADPATTERN "SIDL"  TYPE "Super Dead"  SELFWEIGHT 0
  LOADPATTERN "LIVE"  TYPE "Live"  SELFWEIGHT 0
  LOADPATTERN "EQX"   TYPE "Seismic"  SELFWEIGHT 0
  LOADPATTERN "EQY"   TYPE "Seismic"  SELFWEIGHT 0

$ LOAD CASES
  LOADCASE "DEAD"  TYPE "Linear Static"  INITCOND "ZERO"  LOADPAT "DEAD"  SF 1
  LOADCASE "SIDL"  TYPE "Linear Static"  INITCOND "ZERO"  LOADPAT "SIDL"  SF 1
  LOADCASE "LIVE"  TYPE "Linear Static"  INITCOND "ZERO"  LOADPAT "LIVE"  SF 1

$ LOAD COMBINATIONS
  COMBO "IS456_1.5(DL+LL)"  TYPE "Linear Add"  LOAD "DEAD" SF 1.5  LOAD "SIDL" SF 1.5  LOAD "LIVE" SF 1.5
  COMBO "IS456_1.2(DL+LL+EQX)"  TYPE "Linear Add"  LOAD "DEAD" SF 1.2  LOAD "SIDL" SF 1.2  LOAD "LIVE" SF 1.2  LOAD "EQX" SF 1.2
  COMBO "IS456_1.2(DL+LL+EQY)"  TYPE "Linear Add"  LOAD "DEAD" SF 1.2  LOAD "SIDL" SF 1.2  LOAD "LIVE" SF 1.2  LOAD "EQY" SF 1.2

$ END OF MODEL FILE
