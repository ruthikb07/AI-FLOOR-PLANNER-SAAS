{
  "name": "@ai-floor-planner/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive Architectural Editor & Production SaaS Frontend",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "preview:current": "pnpm run build && vite preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@ai-floor-planner/ai-orchestration": "workspace:*",
    "@ai-floor-planner/core": "workspace:*",
    "@ai-floor-planner/geometry-engine": "workspace:*",
    "@ai-floor-planner/planning-engine": "workspace:*",
    "@ai-floor-planner/projection-3d": "workspace:*",
    "@ai-floor-planner/renderer": "workspace:*",
    "lucide-react": "^0.435.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "@ai-floor-planner/constraint-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "5.5.4",
    "vite": "^5.4.1",
    "vitest": "2.0.5"
  }
}
