{
  "name": "@ai-floor-planner/cota-integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Integrated Cota 2D/3D CAD Engine, 240+ Command Interpreter, CSG Solids, Paper-Space Layouts, Vector PDF Plotter, CAD File Exchange, and Canonical Building Adapter",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --no-error-on-unmatched-pattern",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@ai-floor-planner/constraint-engine": "workspace:*",
    "@ai-floor-planner/core": "workspace:*",
    "@ai-floor-planner/geometry-engine": "workspace:*",
    "@node-projects/acad-ts": "^3.2.0",
    "fflate": "0.8.3",
    "polygon-clipping": "0.15.7",
    "three": "^0.185.1",
    "three-bvh-csg": "^0.0.16",
    "three-mesh-bvh": "^0.8.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  }
}
