{
  "name": "@ai-floor-planner/openbim-integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Integrated OpenBIM Studio Engine: IFC4/IFC4X3 Semantics & Validation, 3D BVH/GJK Clash Coordination, BCF 2.1, IDS 1.0, Classification, 5D QTO, COBie 2.4, and Canonical BIM Adapter",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:unit": "vitest run",
