(princ (strcat "\nARGON_ACADVER=" (getvar "ACADVER")))
(princ (strcat "\nARGON_INSUNITS=" (itoa (getvar "INSUNITS"))))
(princ (strcat "\nARGON_TILEMODE=" (itoa (getvar "TILEMODE"))))
