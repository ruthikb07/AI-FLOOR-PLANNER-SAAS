{
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-server/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "passThroughEnv": ["RH_CARBON4_PYTHON"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tools/structural-python-worker/*.py", "$TURBO_ROOT$/tools/structural-python-worker/uv.lock"],
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "test:unit": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
